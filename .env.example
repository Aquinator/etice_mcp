# Usuário de leitura — usado pelo mcp_server
MARIADB_USER=sac_reader
MARIADB_PASS=<senha>
# Usuário de escrita — novo, para a API CRUD
MARIADB_WRITER_USER=sac_writer
MARIADB_WRITER_PASS=<senha>

# Conexão (compartilhada)
MARIADB_HOST=localhost
MARIADB_PORT=3307
MARIADB_DB=nome_do_banco

# LLM — Google Gemini
GOOGLE_API_KEY=sua_chave_aqui
GEMINI_MODEL=gemini-2.5-flash

